FROM node:20-bookworm-slim AS ui

WORKDIR /src/apps

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY apps/package.json apps/pnpm-lock.yaml apps/vite.config.js apps/index.html ./
COPY apps/src ./src
COPY apps/tests ./tests
COPY apps/scripts ./scripts

RUN pnpm install --frozen-lockfile
RUN pnpm run build

FROM rust:1-bookworm AS builder

WORKDIR /src

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

COPY --from=ui /src/apps/dist ./apps/dist

RUN cargo build -p codexmanager-service --release --features embedded-ui

FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/codexmanager-service /usr/local/bin/codexmanager-service

ENV CODEXMANAGER_SERVICE_ADDR=0.0.0.0:48761
ENV CODEXMANAGER_DB_PATH=/tmp/codexmanager.db

EXPOSE 48761

CMD ["/usr/local/bin/codexmanager-service"]
